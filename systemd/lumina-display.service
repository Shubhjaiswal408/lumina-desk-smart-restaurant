[Unit]
Description=Lumina Desk — ePaper Display Service (MQTT -> panel)
After=network-online.target mosquitto.service
Wants=network-online.target
# An appliance must never stop trying. Without this, five quick
# failures inside ten seconds make systemd give up for good, and the
# table stays dead until somebody SSHs in.
StartLimitIntervalSec=0

[Service]
Type=simple
User=techiesms
SupplementaryGroups=dialout
WorkingDirectory=/home/techiesms/lumina-desk
ExecStart=/home/techiesms/lumina-desk/venv/bin/python -u display_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
