[Unit]
Description=Lumina Desk — Kitchen Display Server (web dashboard)
After=network-online.target mosquitto.service
Wants=network-online.target
# An appliance must never stop trying. Without this, five quick
# failures inside ten seconds make systemd give up for good, and the
# table stays dead until somebody SSHs in.
StartLimitIntervalSec=0

[Service]
Type=simple
User=techiesms
WorkingDirectory=/home/techiesms/lumina-desk
ExecStart=/home/techiesms/lumina-desk/venv/bin/uvicorn kds_server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
