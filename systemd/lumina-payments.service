[Unit]
Description=Lumina Desk — Payment watcher (FamApp email -> bill settled)
After=network-online.target mosquitto.service
Wants=network-online.target
# An appliance must never stop trying. Without this, five quick
# failures inside ten seconds make systemd give up for good, and the
# table stays dead until somebody SSHs in.
StartLimitIntervalSec=0

[Service]
Type=simple
User=techiesms
WorkingDirectory=/home/techiesms/lumina-desk
ExecStart=/home/techiesms/lumina-desk/venv/bin/python -u payment_watcher.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
