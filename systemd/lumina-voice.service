[Unit]
Description=Lumina Desk — Voice Assistant (wake word, ordering)
After=network-online.target mosquitto.service sound.target
Wants=network-online.target
# An appliance must never stop trying. Without this, five quick
# failures inside ten seconds make systemd give up for good, and the
# table stays dead until somebody SSHs in.
StartLimitIntervalSec=0

[Service]
Type=simple
User=techiesms
SupplementaryGroups=audio
WorkingDirectory=/home/techiesms/lumina-desk
ExecStart=/home/techiesms/lumina-desk/venv/bin/python -u wake_listen.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
